#!/usr/bin/env bash
set -euo pipefail

ENV_FILE="/home/Seb06/.env"
name=""

usage() {
    echo "Usage: $0 [-n database-name] <database-url> <database-key>"
    exit 1
}

while getopts ":n:" opt; do
    case "$opt" in
        n) name="$OPTARG" ;;
        *) usage ;;
    esac
done

shift $((OPTIND - 1))

[[ $# -eq 2 ]] || usage

url="$1"
key="$2"

touch "$ENV_FILE"

if [[ -z "$name" ]]; then
    existing_list="$(grep '^SUPABASE_DATABASES=' "$ENV_FILE" | cut -d= -f2- || true)"
    if [[ -z "$existing_list" ]]; then
        name="database-1"
    else
        max_num=$(
            printf '%s\n' "$existing_list" | tr ',' '\n' |
            sed -n 's/^database-\([0-9][0-9]*\)$/\1/p' |
            sort -n | tail -n1
        )
        if [[ -z "$max_num" ]]; then
            name="database-1"
        else
            name="database-$((max_num + 1))"
        fi
    fi
fi

env_prefix="$(printf '%s' "$name" | tr '[:lower:]-' '[:upper:]_')"

if grep -q "^${env_prefix}_URL=" "$ENV_FILE" || grep -q "^${env_prefix}_KEY=" "$ENV_FILE"; then
    echo "Error: database '$name' already exists."
    exit 1
fi

if grep -q '^SUPABASE_DATABASES=' "$ENV_FILE"; then
    current_list="$(grep '^SUPABASE_DATABASES=' "$ENV_FILE" | cut -d= -f2-)"
    if [[ -n "$current_list" ]]; then
        new_list="${current_list},${name}"
    else
        new_list="${name}"
    fi
    sed -i "s/^SUPABASE_DATABASES=.*/SUPABASE_DATABASES=${new_list}/" "$ENV_FILE"
else
    echo "SUPABASE_DATABASES=${name}" >> "$ENV_FILE"
fi

{
    echo ""
    echo "${env_prefix}_URL=${url}"
    echo "${env_prefix}_KEY=${key}"
} >> "$ENV_FILE"

echo "Added database '${name}' to ${ENV_FILE}"

